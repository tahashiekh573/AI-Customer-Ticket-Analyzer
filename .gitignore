cat > .gitignore <<'EOF'
# Python virtual environments
venv/
.venv/

# Python cache files
__pycache__/
*.py[cod]

# Environment variables and secrets
.env
.env.*
!.env.example

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# IDE settings
.idea/
.vscode/

# Generated outputs and databases
outputs/
*.db
*.sqlite
*.sqlite3

# Operating system files
.DS_Store
Thumbs.db
desktop.ini
EOF